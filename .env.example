NODE_ENV=development
PORT=3000

# Docker Compose Postgres maps to 5432; local Homebrew Postgres@16 on this machine uses 5433
DATABASE_URL=postgresql://zeengo:zeengo@localhost:5432/zeengo?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMS_PROVIDER_KEY=

APP_WEB_ORIGIN=http://localhost:5173
APP_MOBILE_SCHEME=zeengo://

VIP_PRICE_USD=100
STRIPE_LINK_DEFAULT_EXPIRY_HOURS=48

# Seed admin (created by prisma db seed)
SEED_ADMIN_EMAIL=admin@zeengo.com
SEED_ADMIN_PASSWORD=Admin123!
