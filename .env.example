NODE_ENV=development
PORT=3000

# API base: http://localhost:${PORT}/api/v1
# Frontend CORS origin (Vite):
APP_WEB_ORIGIN=http://localhost:5173
APP_MOBILE_SCHEME=zeengo://

# Local Homebrew: use zeengo_v1 (current schema). Docker Compose DB name is `zeengo`.
DATABASE_URL=
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=

# Device push (one of these). Leave empty → inbox + websocket still work, no phone push.
# Railway: paste the Firebase service-account JSON (or base64 of it).
FCM_SERVICE_ACCOUNT_JSON=
# Local: absolute path to the downloaded JSON. Alias: GOOGLE_APPLICATION_CREDENTIALS
FCM_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMS_PROVIDER_KEY=

VIP_PRICE_USD=100
STRIPE_LINK_DEFAULT_EXPIRY_HOURS=48

# Seed admin (created by prisma db seed)
SEED_ADMIN_EMAIL=admin@zeengo.com
SEED_ADMIN_PASSWORD=1234567
SEED_STAFF_PASSWORD=1234567
