generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum StaffRole {
  admin
  ops_manager
  splizer
  support
  driver
}

enum DriverStatus {
  available
  en_route
  resting
  off_duty
}

enum OtpPurpose {
  register
  login
  reset_password
}

enum BookingStatus {
  active
  completed
  cancelled
}

enum PaymentMethod {
  cash
  stripe
  rajhi_transfer
  usdt_trc20
}

enum PaymentStatus {
  pending
  sent
  opened
  paid
  expired
  failed
}

enum ItineraryItemStatus {
  pending
  active
  done
  cancelled
}

enum AssignmentStatus {
  active
  completed
  cancelled
}

enum VendorType {
  hotel
  restaurant
  guide
  bus
  activity
  driver
}

enum VendorBookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum VendorPaymentTerms {
  bank_transfer
  cash
  voucher
}

enum EditRequestType {
  date_change
  itinerary_change
  vip_upgrade
  other
}

enum EditRequestStatus {
  pending
  approved
  rejected
}

enum SosStatus {
  active
  resolved
}

enum TaskPriority {
  urgent
  normal
}

enum TaskStatus {
  open
  done
}

enum ConversationType {
  team
  dm
  booking_support
  client_direct
}

enum ParticipantType {
  staff
  client
}

enum SenderType {
  staff
  client
  system
}

enum NotificationRecipientType {
  staff
  client
}

enum NotificationType {
  sos
  payment
  task
  chat
  edit_request
  vip
  system
  assignment
  program
}

enum ActorType {
  staff
  client
  system
  webhook
}

// ---------------------------------------------------------------------------
// Staff & drivers
// ---------------------------------------------------------------------------

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String    @map("full_name")
  email        String    @unique
  phone        String?
  passwordHash String    @map("password_hash")
  role         StaffRole
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  driverProfile            DriverProfile?
  bookingsCreated          Booking[]            @relation("BookingCreatedBy")
  bookingsVipActivated     Booking[]            @relation("BookingVipActivatedBy")
  paymentsCollected        Payment[]            @relation("PaymentCollectedBy")
  driverAssignments        DriverAssignment[]   @relation("DriverAssignmentAssignedBy")
  vendorBookingsCreated    VendorBooking[]      @relation("VendorBookingCreatedBy")
  editRequestsReviewed     EditRequest[]        @relation("EditRequestReviewedBy")
  sosAlertsResolved        SosAlert[]           @relation("SosAlertResolvedBy")
  tasksAssigned            Task[]               @relation("TaskAssignee")
  tasksCreated             Task[]               @relation("TaskCreatedBy")
  checklistItemsCreated    ChecklistItem[]      @relation("ChecklistItemCreatedBy")
  bookingNotes             BookingNote[]
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipantStaff")
  messagesSent             Message[]            @relation("MessageSenderStaff")
  notifications            Notification[]       @relation("NotificationStaff")
  eodReportsGenerated      EodReport[]          @relation("EodReportGeneratedBy")
  settingsUpdated          Setting[]            @relation("SettingUpdatedBy")
  emailsSent               EmailLog[]           @relation("EmailLogSentBy")

  @@index([role])
  @@map("staff_users")
}

model DriverProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  vehicleMake  String?      @map("vehicle_make")
  vehicleModel String?      @map("vehicle_model")
  vehicleColor String?      @map("vehicle_color")
  vehicleYear  Int?         @map("vehicle_year")
  plateNumber  String?      @map("plate_number")
  whatsapp     String?
  rating       Decimal      @default(0) @db.Decimal(2, 1)
  reviewsCount Int          @default(0) @map("reviews_count")
  tripsCount   Int          @default(0) @map("trips_count")
  status       DriverStatus @default(off_duty)
  lastLat      Float?       @map("last_lat")
  lastLng      Float?       @map("last_lng")
  lastGpsAt    DateTime?    @map("last_gps_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              StaffUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  gpsPings          GpsPing[]
  itineraryItems    ItineraryItem[]
  driverAssignments DriverAssignment[]
  reviews           DriverReview[]

  @@index([status])
  @@map("driver_profiles")
}

model GpsPing {
  id         BigInt   @id @default(autoincrement())
  driverId   String   @map("driver_id") @db.Uuid
  lat        Float
  lng        Float
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, recordedAt(sort: Desc)])
  @@map("gps_pings")
}

// ---------------------------------------------------------------------------
// Clients & auth
// ---------------------------------------------------------------------------

model Client {
  id              String    @id @default(uuid()) @db.Uuid
  fullName        String    @map("full_name")
  phone           String    @unique
  email           String?
  nationality     String?
  whatsapp        String?
  passwordHash    String?   @map("password_hash")
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  fcmTokens       Json      @default("[]") @map("fcm_tokens")
  preferredLang   String    @default("ar") @map("preferred_lang")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  bookings                 Booking[]
  otpCodes                 OtpCode[]
  conversationParticipants ConversationParticipant[] @relation("ConversationParticipantClient")
  messagesSent             Message[]                 @relation("MessageSenderClient")
  notifications            Notification[]            @relation("NotificationClient")
  driverReviews            DriverReview[]

  @@map("clients")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  clientId   String?    @map("client_id") @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  attempts   Int        @default(0)

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ---------------------------------------------------------------------------
// Packages & bookings
// ---------------------------------------------------------------------------

model Package {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String    @unique
  pricePerPerson Decimal   @map("price_per_person") @db.Decimal(12, 2)
  minPersons     Int       @default(1) @map("min_persons")
  durationDays   Int?      @map("duration_days")
  description    String?
  inclusions     Json      @default("[]")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  bookings Booking[]

  @@map("packages")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  znCode          String        @unique @map("zn_code")
  clientId        String        @map("client_id") @db.Uuid
  packageId       String        @map("package_id") @db.Uuid
  arrivalDate     DateTime?     @map("arrival_date") @db.Date
  departureDate   DateTime?     @map("departure_date") @db.Date
  partySize       Int           @default(1) @map("party_size")
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  status          BookingStatus @default(active)
  isVip           Boolean       @default(false) @map("is_vip")
  vipActivatedAt  DateTime?     @map("vip_activated_at") @db.Timestamptz(6)
  vipActivatedBy  String?       @map("vip_activated_by") @db.Uuid
  internalNotes   String?       @map("internal_notes")
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  package           Package            @relation(fields: [packageId], references: [id], onDelete: Restrict)
  vipActivatedByUser StaffUser?        @relation("BookingVipActivatedBy", fields: [vipActivatedBy], references: [id], onDelete: SetNull)
  createdByUser     StaffUser          @relation("BookingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  payments          Payment[]
  itineraryItems    ItineraryItem[]
  driverAssignments DriverAssignment[]
  vendorBookings    VendorBooking[]
  editRequests      EditRequest[]
  sosAlerts         SosAlert[]
  checklistItems    ChecklistItem[]
  bookingNotes      BookingNote[]
  conversations     Conversation[]
  tasks             Task[]
  driverReviews     DriverReview[]
  emailLogs         EmailLog[]

  @@index([status])
  @@index([clientId])
  @@index([arrivalDate])
  @@map("bookings")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  amount                Decimal       @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus
  location              String?
  notes                 String?
  collectedBy           String?       @map("collected_by") @db.Uuid
  stripePaymentLinkId   String?       @map("stripe_payment_link_id")
  stripeSessionId       String?       @map("stripe_session_id")
  stripeLinkUrl         String?       @map("stripe_link_url")
  linkExpiresAt         DateTime?     @map("link_expires_at") @db.Timestamptz(6)
  paidAt                DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  collectedByUser StaffUser? @relation("PaymentCollectedBy", fields: [collectedBy], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([collectedBy])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Itinerary & driver assignments
// ---------------------------------------------------------------------------

model ItineraryItem {
  id           String              @id @default(uuid()) @db.Uuid
  bookingId    String              @map("booking_id") @db.Uuid
  dayNumber    Int                 @map("day_number")
  itemDate     DateTime?           @map("item_date") @db.Date
  startTime    DateTime?           @map("start_time") @db.Time(6)
  title        String
  description  String?
  locationName String?             @map("location_name")
  lat          Float?
  lng          Float?
  vendorId     String?             @map("vendor_id") @db.Uuid
  driverId     String?             @map("driver_id") @db.Uuid
  status       ItineraryItemStatus @default(pending)
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  driver         DriverProfile?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vendorBookings VendorBooking[]

  @@index([bookingId, dayNumber, sortOrder])
  @@index([itemDate, status])
  @@index([driverId, itemDate])
  @@map("itinerary_items")
}

model DriverAssignment {
  id         String           @id @default(uuid()) @db.Uuid
  bookingId  String           @map("booking_id") @db.Uuid
  driverId   String           @map("driver_id") @db.Uuid
  startDate  DateTime         @map("start_date") @db.Date
  endDate    DateTime?        @map("end_date") @db.Date
  status     AssignmentStatus @default(active)
  assignedBy String           @map("assigned_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  driver         DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)
  assignedByUser StaffUser     @relation("DriverAssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([bookingId, driverId, startDate])
  @@map("driver_assignments")
}

model DriverReview {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  client  Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  driver  DriverProfile @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([bookingId, driverId])
  @@index([driverId, createdAt])
  @@index([clientId])
  @@map("driver_reviews")
}

// ---------------------------------------------------------------------------
// Vendors
// ---------------------------------------------------------------------------

model Vendor {
  id                  String              @id @default(uuid()) @db.Uuid
  name                String
  type                VendorType
  city                String?
  contactName         String?             @map("contact_name")
  phone               String?
  email               String?
  commissionPct       Decimal             @default(0) @map("commission_pct") @db.Decimal(5, 2)
  paymentTerms        VendorPaymentTerms? @map("payment_terms")
  cancellationPolicy  String?             @map("cancellation_policy")
  notes               String?
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?           @map("deleted_at") @db.Timestamptz(6)

  itineraryItems ItineraryItem[]
  vendorBookings VendorBooking[]

  @@index([type])
  @@index([city])
  @@map("vendors")
}

model VendorBooking {
  id               String              @id @default(uuid()) @db.Uuid
  vendorId         String              @map("vendor_id") @db.Uuid
  bookingId        String              @map("booking_id") @db.Uuid
  itineraryItemId  String?             @map("itinerary_item_id") @db.Uuid
  amount           Decimal?            @db.Decimal(12, 2)
  commissionAmount Decimal?            @map("commission_amount") @db.Decimal(12, 2)
  serviceDate      DateTime?           @map("service_date") @db.Date
  pax              Int?
  details          String?
  voucherCode      String?             @map("voucher_code")
  voucherSentAt    DateTime?           @map("voucher_sent_at") @db.Timestamptz(6)
  status           VendorBookingStatus @default(pending)
  createdBy        String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  itineraryItem ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: SetNull)
  createdByUser StaffUser      @relation("VendorBookingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([vendorId])
  @@index([bookingId])
  @@map("vendor_bookings")
}

// ---------------------------------------------------------------------------
// Edit requests, SOS, tasks, checklist, notes
// ---------------------------------------------------------------------------

model EditRequest {
  id             String            @id @default(uuid()) @db.Uuid
  bookingId      String            @map("booking_id") @db.Uuid
  type           EditRequestType
  originalValue  String?           @map("original_value")
  requestedValue String?           @map("requested_value")
  reason         String?
  status         EditRequestStatus @default(pending)
  reviewNotes    String?           @map("review_notes")
  reviewedBy     String?           @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  booking        Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  reviewedByUser StaffUser? @relation("EditRequestReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([bookingId])
  @@map("edit_requests")
}

model SosAlert {
  id         String    @id @default(uuid()) @db.Uuid
  bookingId  String    @map("booking_id") @db.Uuid
  message    String?
  lat        Float?
  lng        Float?
  status     SosStatus @default(active)
  resolvedBy String?   @map("resolved_by") @db.Uuid
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking          Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  resolvedByUser   StaffUser? @relation("SosAlertResolvedBy", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("sos_alerts")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  priority    TaskPriority @default(normal)
  bookingId   String?      @map("booking_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid
  dueDate     DateTime?    @map("due_date") @db.Date
  status      TaskStatus   @default(open)
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking      Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  assignee     StaffUser? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdByUser StaffUser @relation("TaskCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([status, priority])
  @@index([assigneeId])
  @@index([dueDate])
  @@map("tasks")
}

model ChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  title     String
  isDone    Boolean  @default(false) @map("is_done")
  sortOrder Int      @default(0) @map("sort_order")
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  createdByUser   StaffUser? @relation("ChecklistItemCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([bookingId, sortOrder])
  @@map("checklist_items")
}

model BookingNote {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author  StaffUser @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([bookingId, createdAt(sort: Desc)])
  @@map("booking_notes")
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Conversation {
  id        String           @id @default(uuid()) @db.Uuid
  type      ConversationType
  bookingId String?          @map("booking_id") @db.Uuid
  title     String?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  booking      Booking?                  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([bookingId])
  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  id                 String          @id @default(uuid()) @db.Uuid
  conversationId     String          @map("conversation_id") @db.Uuid
  participantType    ParticipantType @map("participant_type")
  participantKey     String          @map("participant_key")
  staffId            String?         @map("staff_id") @db.Uuid
  clientId           String?         @map("client_id") @db.Uuid
  lastReadMessageId  String?         @map("last_read_message_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff           StaffUser?   @relation("ConversationParticipantStaff", fields: [staffId], references: [id], onDelete: Cascade)
  client          Client?      @relation("ConversationParticipantClient", fields: [clientId], references: [id], onDelete: Cascade)
  lastReadMessage Message?     @relation("ParticipantLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([conversationId, participantKey])
  @@index([staffId])
  @@index([clientId])
  @@map("conversation_participants")
}

model Message {
  id              String     @id @default(uuid()) @db.Uuid
  conversationId  String     @map("conversation_id") @db.Uuid
  senderType      SenderType @map("sender_type")
  senderStaffId   String?    @map("sender_staff_id") @db.Uuid
  senderClientId  String?    @map("sender_client_id") @db.Uuid
  body            String
  bodyTranslated  Json       @default("{}") @map("body_translated")
  sourceLang      String?    @map("source_lang")
  attachments     Json       @default("[]")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation           Conversation              @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderStaff            StaffUser?                @relation("MessageSenderStaff", fields: [senderStaffId], references: [id], onDelete: SetNull)
  senderClient           Client?                   @relation("MessageSenderClient", fields: [senderClientId], references: [id], onDelete: SetNull)
  participantLastReadFor ConversationParticipant[] @relation("ParticipantLastReadMessage")

  @@index([conversationId, createdAt(sort: Desc)])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Notifications, reports, audit, settings, webhooks
// ---------------------------------------------------------------------------

model Notification {
  id            String                  @id @default(uuid()) @db.Uuid
  recipientType NotificationRecipientType @map("recipient_type")
  staffId       String?                 @map("staff_id") @db.Uuid
  clientId      String?                 @map("client_id") @db.Uuid
  type          NotificationType
  title         String
  body          String?
  data          Json                    @default("{}")
  readAt        DateTime?               @map("read_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  staff  StaffUser? @relation("NotificationStaff", fields: [staffId], references: [id], onDelete: Cascade)
  client Client?    @relation("NotificationClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([staffId, readAt])
  @@index([clientId, readAt])
  @@index([type])
  @@map("notifications")
}

model EodReport {
  id          String    @id @default(uuid()) @db.Uuid
  reportDate  DateTime  @unique @map("report_date") @db.Date
  content     String?
  generatedBy String    @map("generated_by") @db.Uuid
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  generatedByUser StaffUser @relation("EodReportGeneratedBy", fields: [generatedBy], references: [id], onDelete: Restrict)

  @@map("eod_reports")
}

model EmailLog {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String?  @map("booking_id") @db.Uuid
  toEmail   String   @map("to_email")
  toName    String?  @map("to_name")
  template  String
  subject   String
  body      String
  status    String
  error     String?
  sentBy    String   @map("sent_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking     Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  sentByUser  StaffUser @relation("EmailLogSentBy", fields: [sentBy], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([bookingId])
  @@map("email_logs")
}

model AuditLog {
  id        BigInt    @id @default(autoincrement())
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  action    String
  entity    String?
  entityId  String?   @map("entity_id") @db.Uuid
  diff      Json?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedByUser StaffUser? @relation("SettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("settings")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@index([type])
  @@map("stripe_webhook_events")
}
